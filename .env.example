# Runtime profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# Database
MYSQL_DATABASE=userdb
MYSQL_USER=ecommerce
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DB_URL=jdbc:mysql://localhost:3306/userdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&tinyInt1isBit=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SPRING_KAFKA_PRODUCER_RETRIES=10
AUTH_KAFKA_TOPIC_GUARD_ENABLED=true
AUTH_KAFKA_TOPIC_GUARD_TIMEOUT_SECONDS=10

# Public links used in notification emails.
# Point this to the frontend, not the auth API.
AUTH_PUBLIC_BASE_URL=http://localhost:3000
AUTH_EMAIL_VERIFICATION_PATH=/verify
AUTH_PASSWORD_RESET_PATH=/reset-password
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30

# Google Sign-In: comma-separated OAuth 2.0 client IDs allowed to call this API.
# Public client IDs are safe to expose to web/mobile apps, but must still be environment-specific.
AUTH_GOOGLE_ALLOWED_CLIENT_IDS=
# Override only in isolated tests; production must use Google's JWKS endpoint.
AUTH_GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
# OAuth authorization-code flow (required only for /google/authorize and /google/callback).
AUTH_GOOGLE_AUTHORIZATION_CLIENT_ID=
AUTH_GOOGLE_AUTHORIZATION_CLIENT_SECRET=
AUTH_GOOGLE_AUTHORIZATION_REDIRECT_URI=http://localhost:8081/api/v1/auth/google/callback
AUTH_GOOGLE_AUTHORIZATION_COOKIE_SECURE=false

# Outbox
AUTH_OUTBOX_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
AUTH_OUTBOX_PUBLISHER_ENABLED=true
AUTH_OUTBOX_PUBLISHER_SEND_TIMEOUT_MS=35000
AUTH_OUTBOX_MAX_PENDING_EVENTS=1000
AUTH_OUTBOX_MAX_OLDEST_PENDING_AGE_SECONDS=300
AUTH_OUTBOX_MAX_FAILED_EVENTS=0
AUTH_OUTBOX_CLEANUP_ENABLED=true
AUTH_OUTBOX_CLEANUP_FIXED_DELAY_MS=3600000
AUTH_OUTBOX_CLEANUP_PUBLISHED_RETENTION_DAYS=7
AUTH_OUTBOX_CLEANUP_FAILED_RETENTION_DAYS=30
AUTH_OUTBOX_CLEANUP_BATCH_SIZE=500

# Security keys
AUTH_AUDIT_HASH_KEY_BASE64=replace-with-32-byte-base64-key
AUTH_OTP_HASH_KEY_BASE64=replace-with-32-byte-base64-key
AUTH_MFA_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key

# JWT keys
JWT_KEY_ID=auth-user-key-local-1
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64-pem-private-key
AUTH_JWT_PUBLIC_KEY_BASE64=replace-with-base64-pem-public-key
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY_BASE64=

# KYC
AUTH_KYC_EXPIRY_ENABLED=true
AUTH_KYC_EXPIRY_BATCH_SIZE=50
AUTH_KYC_EXPIRY_FIXED_DELAY_MS=60000
AUTH_KYC_SUBMISSION_EXPIRY_DAYS=30
